{
  "ReverseProxy": {
    "Routes": {
      "catalog-products-route": {
        "ClusterId": "catalog-service",
        "Order": 0,
        "Match": {
          "Path": "/api/product"
        }
      },
      "catalog-product-details-route": {
        "ClusterId": "catalog-service",
        "Order": 0,
        "Match": {
          "Path": "/api/product/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-service",
        "Order": 0,
        "Match": {
          "Path": "/api/category"
        }
      },
      "legacy-api-route": {
        "ClusterId": "legacy-api",
        "Order": 1,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-service": {
        "Destinations": {
          "catalog-service-instance": {
            "Address": "http://localhost:5180/"
          }
        }
      },
      "legacy-api": {
        "Destinations": {
          "legacy-api-instance": {
            "Address": "http://localhost:5178/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}